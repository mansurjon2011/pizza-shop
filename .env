# Скопируйте этот файл в .env и заполните значения
PORT=3000
# Публичный адрес сайта (с https://). Нужен для ссылок возврата после оплаты
SITE_URL=http://localhost:3000
SHOP_NAME=Папа Пиццоли

# Админка. Хеш пароля получить командой: npm run hash -- "ВашПароль"
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
# Любая длинная случайная строка (минимум 32 символа)
JWT_SECRET=

# Доставка (в сумах). Бесплатно от суммы FREE_DELIVERY_FROM (0 = всегда платно)
DELIVERY_FEE=10000
FREE_DELIVERY_FROM=150000

# Уведомления о заказах в Telegram (необязательно)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Payme (кабинет Payme Business). PAYME_TEST=true для тестового режима
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST=true

# Click (кабинет Click Merchant, схема Shop API)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# Демо-оплата кнопкой «Оплатить» БЕЗ реальных денег. Только для проверки! На боевом сайте: false
DEMO_PAYMENTS=true
